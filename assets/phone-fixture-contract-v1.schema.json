{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "iso2": {
      "type": "string",
      "minLength": 1
    },
    "callingCode": {
      "type": "string",
      "minLength": 1
    },
    "nationalPattern": {
      "type": "string",
      "minLength": 1
    },
    "e164Example": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{1,14}$"
    },
    "nationalDigits": {
      "type": "string",
      "minLength": 1
    },
    "fixtureSafety": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "type": "string",
      "minLength": 1
    },
    "delivery_allowed": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema_version",
    "country",
    "iso2",
    "callingCode",
    "nationalPattern",
    "e164Example",
    "nationalDigits",
    "fixtureSafety",
    "sourceUrl",
    "delivery_allowed"
  ],
  "additionalProperties": false
}
